# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geotrackhr
DB_USER=geotrackhr_user
DB_PASSWORD=change_me_in_production

# JWT Auth
JWT_SECRET=change_this_to_a_secure_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Argon2
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Facial Verification (placeholder threshold)
FACIAL_MATCH_THRESHOLD=0.85

# Leave entitlements (days/year, per leave_type; 'unpaid' has no cap)
LEAVE_ANNUAL_DAYS=21
LEAVE_SICK_DAYS=10
LEAVE_CASUAL_DAYS=7
LEAVE_EMERGENCY_DAYS=5
LEAVE_MATERNITY_DAYS=90

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Redis (for future use: session store, queue)
REDIS_HOST=localhost
REDIS_PORT=6379