{
  "name": "geotrackhr-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GeoTrackHR Backend API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:rollback": "tsx src/database/migrate.ts --rollback",
    "db:seed": "tsx src/database/seed.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "argon2": "^0.31.2",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "zod": "^3.22.4",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.4",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/compression": "^1.7.5",
    "typescript": "^5.3.2",
    "tsx": "^4.6.2",
    "tsc-alias": "^1.8.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  }
}