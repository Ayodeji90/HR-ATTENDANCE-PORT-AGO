# GeoTrackHR admin dashboard — production API endpoint.
# Vite loads this file during `vite build` (what Netlify runs) and bakes the
# URL into the bundle, so the frontend knows where the backend lives.
# A VITE_API_BASE_URL set in the Netlify dashboard (Site settings →
# Environment variables) takes precedence over this file if it's ever set.
VITE_API_BASE_URL=https://geotrackhr-api.onrender.com/api
